# MCP CLI Project - Environment Configuration
# Note: By default, python-dotenv will automatically load variables from the
# repository root .env file. Copy this file to .env only if you want to override
# settings specifically for this subproject.
# Never commit .env to version control (it is in .gitignore).

# Anthropic API Key (inherited from root .env if not set here)
ANTHROPIC_API_KEY=""

# Model to use for chat
CLAUDE_MODEL="claude-haiku-4-5"

# Set to 1 if you're using uv to run the project
# Set to 0 if you're using standard python
USE_UV=1

