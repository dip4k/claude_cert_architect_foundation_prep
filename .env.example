# Claude Certified Architect Foundation - Environment Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control (it is in .gitignore)

# Anthropic API Key (Required for Claude API calls)
# Get your API key from: https://console.anthropic.com/account/keys
# Replace 'sk-ant-your-api-key-here' with your actual API key
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Model Selection (defaults to claude-haiku-4-5 if not set)
# Available Claude models:
#   - claude-opus-5 (most capable, for complex reasoning and tasks)
#   - claude-sonnet-5 (balanced intelligence and speed, recommended)
#   - claude-haiku-4-5 / claude-haiku-5-5 (fastest, economical)
#   - claude-fable-5-1 (lightweight option)
CLAUDE_MODEL=claude-haiku-4-5

# Optional: Enable verbose logging for debugging
# Set to "true" to enable debug output
DEBUG=false

# CLI & MCP Project Configuration
# Set to 1 to use 'uv run' when launching MCP servers and child processes
# Set to 0 to use standard 'python'
USE_UV=1
