# Claude Certified Architect Foundation - Environment Configuration
# Copy this file to .env and fill in your actual values
# .env is gitignored for security - never commit API keys

# Anthropic API Key (Required for Claude API calls)
# Get your API key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Model Selection (defaults to claude-haiku-4-5 if not set)
# Claude models: claude-opus-5, claude-sonnet-5, claude-haiku-4-5, claude-fable-5-1
CLAUDE_MODEL=claude-haiku-4-5

# Optional: Enable verbose logging for debugging
# Set to "true" to enable debug output
DEBUG=false
